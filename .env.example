# Environment Variables — Copy to .env.local and fill in values

# Database
DATABASE_URL="postgresql://virelo:virelo_secret@localhost:5432/virelo_rewards"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-change-this-in-production"

# Email (optional — for OTP verification)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="Virelo Rewards <noreply@virelo.com>"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Virelo Rewards"
