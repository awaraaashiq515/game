// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


// ─── ENUMS ─────────────────────────────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  UNDER_REVIEW
  DELETED
}

enum TransactionType {
  VIDEO_REWARD
  REFERRAL_REWARD
  BONUS
  ADJUSTMENT
  WITHDRAWAL_DEBIT
  REVERSAL
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
  ARCHIVED
}

enum WatchSessionStatus {
  STARTED
  IN_PROGRESS
  COMPLETED
  ABANDONED
  FLAGGED
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
  FAILED
}

enum DepositStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReferralStatus {
  PENDING
  QUALIFIED
  REWARDED
}

enum FraudSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BrandApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationCategory {
  REWARD
  REFERRAL
  WITHDRAWAL
  ACCOUNT
  SYSTEM
}

// ─── USER ──────────────────────────────────────────────────────────────────

model User {
  id              String        @id @default(cuid())
  email           String        @unique
  emailVerified   DateTime?
  mobile          String?       @unique
  mobileVerified  DateTime?
  name            String
  passwordHash    String
  avatar          String?
  referralCode    String        @unique
  referredById    String?
  role            Role          @default(USER)
  status          AccountStatus @default(ACTIVE)
  lastLoginAt     DateTime?
  lastLoginIp     String?
  deviceFingerprint String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  wallet          Wallet?
  referredBy      User?         @relation("referrals", fields: [referredById], references: [id])
  referrals       User[]        @relation("referrals")
  watchSessions   VideoWatchSession[]
  videoCompletions VideoCompletion[]
  referralsMade   Referral[]    @relation("referrer")
  referralReceived Referral?    @relation("referee")
  withdrawals     Withdrawal[]
  depositRequests DepositRequest[]
  notifications   Notification[]
  fraudEvents     FraudEvent[]
  adminLogs       AdminActionLog[] @relation("targetUser")

  @@index([email])
  @@index([referralCode])
  @@index([status])
}

// ─── WALLET ────────────────────────────────────────────────────────────────

model Wallet {
  id                String   @id @default(cuid())
  userId            String   @unique
  availableBalance  Float    @default(0)
  pendingBalance    Float    @default(0)
  totalEarned       Float    @default(0)
  totalWithdrawn    Float    @default(0)
  videoEarnings     Float    @default(0)
  referralEarnings  Float    @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user         User               @relation(fields: [userId], references: [id])
  transactions WalletTransaction[]
}

model WalletTransaction {
  id          String            @id @default(cuid())
  walletId    String
  type        TransactionType
  status      TransactionStatus @default(COMPLETED)
  amount      Float
  description String
  reference   String?           // External ref (withdrawal ID, session ID, etc.)
  metadata    Json?
  createdAt   DateTime          @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id])

  @@index([walletId])
  @@index([type])
  @@index([createdAt])
}

// ─── VIDEO CAMPAIGN ────────────────────────────────────────────────────────

model VideoCampaign {
  id              String         @id @default(cuid())
  name            String
  sponsor         String
  description     String?
  thumbnailUrl    String?
  videoUrl        String
  rewardAmount    Float          @default(20)
  watchDuration   Int            @default(30)  // seconds required
  dailyLimit      Int            @default(10)  // per user per day
  totalBudget     Float
  spentBudget     Float          @default(0)
  startDate       DateTime?
  endDate         DateTime?
  status          CampaignStatus @default(DRAFT)
  totalViews      Int            @default(0)
  totalCompletions Int           @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  watchSessions    VideoWatchSession[]
  videoCompletions VideoCompletion[]
}

model VideoWatchSession {
  id           String             @id @default(cuid())
  userId       String
  campaignId   String
  status       WatchSessionStatus @default(STARTED)
  startedAt    DateTime           @default(now())
  completedAt  DateTime?
  watchedSeconds Int              @default(0)
  ipAddress    String?
  userAgent    String?
  sessionToken String             @unique @default(cuid())
  heartbeatAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  user     User          @relation(fields: [userId], references: [id])
  campaign VideoCampaign @relation(fields: [campaignId], references: [id])
  completion VideoCompletion?

  @@index([userId])
  @@index([campaignId])
  @@index([sessionToken])
  @@index([userId, campaignId])
}

model VideoCompletion {
  id          String   @id @default(cuid())
  userId      String
  campaignId  String
  sessionId   String   @unique
  rewardAmount Float
  completedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  user     User              @relation(fields: [userId], references: [id])
  campaign VideoCampaign     @relation(fields: [campaignId], references: [id])
  session  VideoWatchSession @relation(fields: [sessionId], references: [id])

  @@index([userId])
  @@index([campaignId])
  @@index([userId, campaignId])
}

// ─── REFERRAL ──────────────────────────────────────────────────────────────

model Referral {
  id              String        @id @default(cuid())
  referrerId      String
  refereeId       String        @unique
  status          ReferralStatus @default(PENDING)
  qualifiedAt     DateTime?
  rewardAmount    Float?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  referrer        User          @relation("referrer", fields: [referrerId], references: [id])
  referee         User          @relation("referee", fields: [refereeId], references: [id])
  rewards         ReferralReward[]

  @@index([referrerId])
  @@index([status])
}

model ReferralReward {
  id          String   @id @default(cuid())
  referralId  String
  amount      Float
  creditedAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  referral Referral @relation(fields: [referralId], references: [id])
}

// ─── WITHDRAWAL ────────────────────────────────────────────────────────────

model Withdrawal {
  id              String           @id @default(cuid())
  requestId       String           @unique @default(cuid())
  userId          String
  amount          Float
  method          String           // UPI, BANK, PHONEPE, GPAY
  accountDetails  Json             // UPI ID, bank details, etc.
  status          WithdrawalStatus @default(PENDING)
  adminNote       String?
  paymentRef      String?          // UTR / transaction ref after payment
  requestedAt     DateTime         @default(now())
  processedAt     DateTime?
  updatedAt       DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([requestedAt])
}

// ─── DEPOSIT ───────────────────────────────────────────────────────────────
// User sends real money to Admin's UPI → submits UTR → Admin approves → Wallet credited

model DepositRequest {
  id          String        @id @default(cuid())
  userId      String
  amount      Float
  utrNumber   String        // UTR / Transaction ID user got from PhonePe/GPay
  senderUpi   String?       // Optional: sender's UPI ID for verification
  status      DepositStatus @default(PENDING)
  adminNote   String?
  requestedAt DateTime      @default(now())
  processedAt DateTime?
  updatedAt   DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([utrNumber])
  @@index([requestedAt])
}

// ─── NOTIFICATION ──────────────────────────────────────────────────────────

model Notification {
  id        String               @id @default(cuid())
  userId    String
  category  NotificationCategory
  title     String
  message   String
  isRead    Boolean              @default(false)
  metadata  Json?
  createdAt DateTime             @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([isRead])
}

// ─── FRAUD EVENT ───────────────────────────────────────────────────────────

model FraudEvent {
  id          String        @id @default(cuid())
  userId      String?
  type        String        // DUPLICATE_SESSION, FAST_COMPLETION, IP_ABUSE, etc.
  severity    FraudSeverity @default(LOW)
  description String
  metadata    Json?
  ipAddress   String?
  resolved    Boolean       @default(false)
  createdAt   DateTime      @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([type])
  @@index([severity])
  @@index([resolved])
}

// ─── ADMIN ────────────────────────────────────────────────────────────────

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  actionLogs AdminActionLog[]
}

model AdminActionLog {
  id           String   @id @default(cuid())
  adminId      String
  targetUserId String?
  action       String
  description  String
  metadata     Json?
  createdAt    DateTime @default(now())

  admin      AdminUser @relation(fields: [adminId], references: [id])
  targetUser User?     @relation("targetUser", fields: [targetUserId], references: [id])

  @@index([adminId])
  @@index([targetUserId])
}

// ─── SYSTEM CONFIG ─────────────────────────────────────────────────────────

model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  label     String?
  group     String?
  updatedAt DateTime @updatedAt

  @@index([key])
  @@index([group])
}

// ─── ADMIN MASTER WALLET ───────────────────────────────────────────────────

model AdminWallet {
  id                   String   @id @default(cuid())
  totalFundsAdded      Float    @default(0)   // Total manually added by admin
  totalDistributed     Float    @default(0)   // Total paid out to users (ads+referrals)
  totalWithdrawnByUsers Float   @default(0)   // Total users withdrew (paid status)
  availablePool        Float    @default(0)   // Current pool = totalFundsAdded - totalDistributed
  updatedAt            DateTime @updatedAt
}

model AdminWalletTransaction {
  id          String   @id @default(cuid())
  type        String   // FUND_ADD, USER_REWARD, USER_WITHDRAWAL
  amount      Float
  description String
  reference   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([type])
  @@index([createdAt])
}

// ─── BRAND APPLICATIONS ────────────────────────────────────────────────────
// Brands/companies apply karte hain apna ad platform pe lagwane ke liye

model BrandApplication {
  id          String                 @id @default(cuid())
  brandName   String
  contactName String
  email       String
  phone       String?
  website     String?
  category    String                 // Fashion, Tech, Food, Finance, etc.
  budget      String                 // e.g. "₹10,000 - ₹50,000"
  message     String                 // Campaign description
  status      BrandApplicationStatus @default(PENDING)
  adminNote   String?
  submittedAt DateTime               @default(now())
  reviewedAt  DateTime?
  updatedAt   DateTime               @updatedAt

  @@index([status])
  @@index([submittedAt])
}
